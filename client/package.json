{
    "name": "nutrition-tracker-client",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "lint-fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
        "format": "prettier . --write",
        "openapi": "openapi-generator-cli generate -i ../api.yaml -g typescript-fetch -o src/Gen/ --additional-properties=withInterfaces=true",
        "generate": "npm run openapi && npm run lint-fix && npm run format",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/vue-fontawesome": "^3.3.3",
        "@openapitools/openapi-generator-cli": "^2.41.0",
        "@types/debounce": "^1.2.4",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/tsconfig": "^0.9.1",
        "@vueuse/components": "^15.0.0",
        "@vueuse/core": "^15.0.0",
        "buefy": "^3.1.0",
        "bulma": "^1.0.4",
        "debounce": "^3.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "jwt-decode": "^4.0.0",
        "pinia": "^4.0.3",
        "prettier": "^3.9.6",
        "sass": "^1.104.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "uuid": "^14.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.0",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1",
        "vue-tsc": "^3.3.11"
    },
    "packageManager": "pnpm@11.10.0"
}
